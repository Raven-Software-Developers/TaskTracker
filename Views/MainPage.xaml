<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskTracker.ViewModels"
             xmlns:models="clr-namespace:TaskTracker.Models"
             x:Class="TaskTracker.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#121212"
             >
	<!-- Важно: вызов загрузки при появлении страницы -->

	<VerticalStackLayout Spacing="20" Padding="20">

		<Label Text="Трекер задач на день"
               FontSize="28"
               TextColor="White"
               HorizontalOptions="Center" />

		<Entry Text="{Binding NewTaskDescription}"
               Placeholder="Введите новую задачу"
               TextColor="White"
               PlaceholderColor="LightGray"
               BackgroundColor="#333333"
               FontSize="16"
               ReturnType="Done"
               ReturnCommand="{Binding AddTaskCommand}" />

		<Button Text="Добавить задачу"
                Command="{Binding AddTaskCommand}"
                BackgroundColor="#007ACC"
                TextColor="White"
                CornerRadius="10"
                FontSize="16"
                HorizontalOptions="FillAndExpand" />

		<!-- Основной список задач — теперь точно видно -->
		<CollectionView ItemsSource="{Binding Tasks}"
                        VerticalOptions="FillAndExpand"
                        MinimumHeightRequest="300"
                        BackgroundColor="#1E1E1E"
                        Margin="0,10,0,10">

			<CollectionView.EmptyView>
				<VerticalStackLayout Padding="20" HorizontalOptions="Center">
					<Label Text="Нет задач на сегодня"
                           TextColor="LightGray"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />
					<Label Text="Добавьте новую задачу выше ↑"
                           TextColor="Gray"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
				</VerticalStackLayout>
			</CollectionView.EmptyView>

			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="models:DailyTask">
					<Grid Padding="12,16" BackgroundColor="#2D2D2D" Margin="0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<!-- CheckBox -->
							<ColumnDefinition Width="*" />
							<!-- Текст задачи -->
							<ColumnDefinition Width="Auto" />
							<!-- Кнопка -->
						</Grid.ColumnDefinitions>

						<!-- Чекбокс -->
						<CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsCompleted}"
                                  VerticalOptions="Center"
                                  Color="#007ACC" />

						<!-- Описание -->
						<Label Grid.Column="1"
                               Text="{Binding Description}"
                               TextColor="White"
                               FontSize="17"
                               VerticalOptions="Center"
                               Margin="15,0,0,0" />

						<!-- Кнопка переключения -->
						<Button Grid.Column="2"
                                Text="✓"
                                FontSize="24"
                                WidthRequest="50"
                                HeightRequest="50"
                                BackgroundColor="#007ACC"
                                TextColor="White"
                                CornerRadius="25"
                                VerticalOptions="Center"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ToggleCompletedCommand}"
                                CommandParameter="{Binding .}" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<Button Text="Обновить список"
                Command="{Binding LoadTasksCommand}"
                BackgroundColor="#555555"
                TextColor="White"
                CornerRadius="10"
                FontSize="16"
                HorizontalOptions="FillAndExpand" />
	</VerticalStackLayout>
</ContentPage>