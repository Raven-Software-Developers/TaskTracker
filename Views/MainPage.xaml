<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskTracker.ViewModels"
             xmlns:models="clr-namespace:TaskTracker.Models"
             x:Class="TaskTracker.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#121212">

    <!-- Локальная регистрация конвертера (на случай проблем с App.xaml) -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EnumToDisplayNameConverter x:Key="EnumToDisplayNameConverter"
                                                   xmlns:converters="clr-namespace:TaskTracker.Converters" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Основной Grid вместо VerticalStackLayout для правильного распределения пространства -->
    <Grid Padding="20" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Заголовок -->
            <RowDefinition Height="Auto" />
            <!-- Кнопки дат -->
            <RowDefinition Height="Auto" />
            <!-- DatePicker -->
            <RowDefinition Height="Auto" />
            <!-- Picker категории -->
            <RowDefinition Height="Auto" />
            <!-- Entry -->
            <RowDefinition Height="Auto" />
            <!-- Кнопка добавить -->
            <RowDefinition Height="Auto" />
            <!-- Фильтр -->
            <RowDefinition Height="*" />
            <!-- CollectionView (растягивается) -->
            <RowDefinition Height="Auto" />
            <!-- Кнопка обновить -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Label Grid.Row="0"
               Text="{Binding PageTitle}"
               FontSize="26"
               TextColor="White"
               HorizontalOptions="Center" />

        <!-- Кнопки Вчера / Сегодня / Завтра -->
        <HorizontalStackLayout Grid.Row="1"
                               Spacing="10"
                               HorizontalOptions="Center">
            <Button Text="Вчера" Command="{Binding SetYesterdayCommand}" BackgroundColor="#555555" TextColor="White" />
            <Button Text="Сегодня" Command="{Binding SetTodayCommand}" BackgroundColor="#007ACC" TextColor="White" />
            <Button Text="Завтра" Command="{Binding SetTomorrowCommand}" BackgroundColor="#555555" TextColor="White" />
        </HorizontalStackLayout>

        <!-- Выбор даты -->
        <DatePicker Grid.Row="2"
                    Date="{Binding SelectedDate}"
                    Format="dd MMMM yyyy"
                    TextColor="White"
                    BackgroundColor="#333333"
                    HorizontalOptions="Fill" />

        <!-- Категория для новой задачи -->
        <Picker Grid.Row="3"
                Title="Категория задачи"
                ItemsSource="{Binding Categories}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumToDisplayNameConverter}}"
                SelectedItem="{Binding SelectedCategory}"
                TextColor="White"
                BackgroundColor="#333333"
                HorizontalOptions="Fill" />

        <!-- Поле ввода -->
        <Entry Grid.Row="4"
               Text="{Binding NewTaskDescription}"
               Placeholder="Введите новую задачу"
               TextColor="White"
               PlaceholderColor="LightGray"
               BackgroundColor="#333333"
               ReturnType="Done"
               ReturnCommand="{Binding AddTaskCommand}" />

        <!-- Кнопка добавить -->
        <Button Grid.Row="5"
                Text="Добавить задачу"
                Command="{Binding AddTaskCommand}"
                BackgroundColor="#007ACC"
                TextColor="White"
                CornerRadius="10"
                FontSize="16"
                HorizontalOptions="Fill" />

        <!-- Фильтр по категории (кнопки-чипы) -->
        <VerticalStackLayout Grid.Row="6" Spacing="8">
            <Label Text="Фильтр по категории:"
                   TextColor="White"
                   FontSize="14" />
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Start">
                <!-- Кнопка "Все" -->
                <Button Text="Все"
                        BackgroundColor="#666666"
                        TextColor="White"
                        CornerRadius="15"
                        Padding="12,6"
                        Command="{Binding ClearCategoryFilterCommand}" />

                <!-- Кнопки категорий -->
                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TaskCategory">
                            <Button Text="{Binding ., Converter={StaticResource EnumToDisplayNameConverter}}"
                                    BackgroundColor="#555555"
                                    TextColor="White"
                                    CornerRadius="15"
                                    Padding="12,6"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=SetCategoryFilterCommand}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Список задач — растягивается на всё доступное место -->
        <CollectionView Grid.Row="7"
                        ItemsSource="{Binding Tasks}"
                        BackgroundColor="#1E1E1E"
                        Margin="0,10">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Нет задач на эту дату"
                           TextColor="LightGray"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DailyTask">
                    <Grid Padding="12,16" BackgroundColor="#2D2D2D" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsCompleted}"
                                  Color="#007ACC"
                                  VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0">
                            <Label Text="{Binding Description}"
                                   TextColor="White"
                                   FontSize="17" />
                            <Label Text="{Binding Category, Converter={StaticResource EnumToDisplayNameConverter}}"
                                   TextColor="LightBlue"
                                   FontSize="13"
                                   FontAttributes="Italic" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="✓"
                                FontSize="24"
                                WidthRequest="50"
                                HeightRequest="50"
                                BackgroundColor="#007ACC"
                                TextColor="White"
                                CornerRadius="25"
                                VerticalOptions="Center"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ToggleCompletedCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Кнопка обновить -->
        <Button Grid.Row="8"
                Text="Обновить список"
                Command="{Binding LoadTasksCommand}"
                BackgroundColor="#555555"
                TextColor="White"
                CornerRadius="10"
                FontSize="16"
                HorizontalOptions="Fill" />
    </Grid>
</ContentPage>