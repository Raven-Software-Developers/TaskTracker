<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskTracker.ViewModels"
             xmlns:models="clr-namespace:TaskTracker.Models"
             x:Class="TaskTracker.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#121212">

    <VerticalStackLayout Spacing="15" Padding="20">

        <!-- Заголовок и выбор даты -->
        <Label Text="{Binding PageTitle}"
               FontSize="26"
               TextColor="White"
               HorizontalOptions="Center" />

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Button Text="Вчера" Command="{Binding SetYesterdayCommand}" BackgroundColor="#555555" TextColor="White" />
            <Button Text="Сегодня" Command="{Binding SetTodayCommand}" BackgroundColor="#007ACC" TextColor="White" />
            <Button Text="Завтра" Command="{Binding SetTomorrowCommand}" BackgroundColor="#555555" TextColor="White" />
        </HorizontalStackLayout>

        <DatePicker Date="{Binding SelectedDate}"
                    DateSelected="OnDateSelected"
                    Format="dd MMMM yyyy"
                    TextColor="White"
                    BackgroundColor="#333333"
                    HorizontalOptions="Fill" />

        <!-- Поле ввода -->
        <Entry Text="{Binding NewTaskDescription}"
               Placeholder="Введите новую задачу на выбранную дату"
               TextColor="White"
               PlaceholderColor="LightGray"
               BackgroundColor="#333333"
               ReturnType="Done"
               ReturnCommand="{Binding AddTaskCommand}" />

        <Button Text="Добавить задачу"
                Command="{Binding AddTaskCommand}"
                BackgroundColor="#007ACC"
                TextColor="White"
                CornerRadius="10"
                HorizontalOptions="FillAndExpand" />

        <!-- Список задач -->
        <CollectionView ItemsSource="{Binding Tasks}"
                        VerticalOptions="FillAndExpand"
                        MinimumHeightRequest="300"
                        BackgroundColor="#1E1E1E">

            <CollectionView.EmptyView>
                <Label Text="Нет задач на эту дату"
                       TextColor="LightGray"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="CenterAndExpand" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DailyTask">
                    <Grid Padding="12" BackgroundColor="#2D2D2D" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" Color="#007ACC" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Description}" TextColor="White" FontSize="17" VerticalOptions="Center" Margin="15,0" />
                        <Button Grid.Column="2" Text="✓" FontSize="24" WidthRequest="50" HeightRequest="50" BackgroundColor="#007ACC" TextColor="White" CornerRadius="25"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ToggleCompletedCommand}" CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Обновить список"
                Command="{Binding LoadTasksCommand}"
                BackgroundColor="#555555"
                TextColor="White"
                CornerRadius="10"
                HorizontalOptions="FillAndExpand" />
    </VerticalStackLayout>
</ContentPage>