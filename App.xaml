<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TaskTracker"
             xmlns:converters="clr-namespace:TaskTracker.Converters"
             x:Class="TaskTracker.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Мержим стандартные стили -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Регистрация конвертеров (доступны во всём приложении) -->
            <converters:EnumToDisplayNameConverter x:Key="EnumToDisplayNameConverter" />

            <!-- Если добавишь другие конвертеры — регистрируй здесь же -->
            <!-- <converters:AnotherConverter x:Key="AnotherConverter" /> -->

        </ResourceDictionary>
    </Application.Resources>
</Application>